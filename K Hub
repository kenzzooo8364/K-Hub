local cleanup, alive = {}, true
local function safe(fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then warn("[zpost-Q] " .. tostring(err)) end
    return ok, err
end
local function unload()
    alive = false
    for _, f in ipairs(cleanup) do safe(f) end
    cleanup = {}
    genv.ZPOST_EVO = nil
end
genv.ZPOST_EVO = unload

-- ===== packets =====
local packets
local function getPackets()
    if packets then return packets end
    safe(function()
        local m = RS:FindFirstChild("packets") or RS:FindFirstChild("packets", true)
        if not m then return end
        local r = require(m)
        if type(r) == "table" and (r.bytenet_findBall or r.bytenet_selectRole) then packets = r end
    end)
    return packets
end
local function send(name, ...)
    local p = getPackets()
    local pk = p and p[name]
    if not pk then return false end
    local a = table.pack(...)
    if pcall(function() pk.send(table.unpack(a, 1, a.n)) end) then return true end
    return (pcall(function() pk:send(table.unpack(a, 1, a.n)) end))
end
local function findBallRemote() -- fallback kalau require nggak jalan
    local r = RS:FindFirstChild("ByteNetReliable") or RS:FindFirstChild("Reliable", true)
    if not r or not buffer then return false end
    local id = 29
    safe(function()
        local s = RS:FindFirstChild("BytenetStorage")
        local n = s and s:FindFirstChild("Networking")
        local d = n and game:GetService("HttpService"):JSONDecode(n.Value)
        if d and d.packets and d.packets.bytenet_findBall then id = d.packets.bytenet_findBall end
    end)
    return (pcall(function() r:FireServer(buffer.fromstring(string.char(id))) end))
end

-- ===== helpers =====
local function hasBall()
    local w = RS:FindFirstChild("workspace")
    local holder = w and w:FindFirstChild("ballHolder")
    if holder and holder.Value and holder.Value == LP.Character then return true end
    local chars = WS:FindFirstChild("characters")
    local c = chars and chars:FindFirstChild(LP.Name)
    return c ~= nil and (c:FindFirstChild("Ball") ~= nil or c:FindFirstChild("AlternateBallRig") ~= nil)
end
local function ballPos()
    local cf = RS:FindFirstChild("CFBall")
    if cf and cf:IsA("CFrameValue") then return cf.Value.Position end
    local t = WS:FindFirstChild("Terrain")
    local b = (t and (t:FindFirstChild("Ball") or t:FindFirstChild("MarbleStuckBall"))) or WS:FindFirstChild("Ball")
    if b and b:IsA("BasePart") then return b.Position end
end

-- ===== FAST AUTO-PICKUP =====
local MAX_RANGE = 15
local fp = { on = false, show = false, range = 12 }
local RESTRICTED = {
    ["81249694116204"] = true, ["115839777221212"] = true, ["127428631641330"] = true,
    ["97586424269981"] = true, ["133565559497234"] = true, ["79074253499106"] = true,
}
local function restricted(hum)
    local an = hum:FindFirstChildOfClass("Animator")
    if not an then return false end
    for _, tr in ipairs(an:GetPlayingAnimationTracks()) do
        local id = tr.Animation and tostring(tr.Animation.AnimationId):match("%d+")
        if id and RESTRICTED[id] then return true end
    end
    return false
end

local ring = Instance.new("Part")
ring.Anchored, ring.CanCollide, ring.CanQuery, ring.CanTouch = true, false, false, false
ring.Shape, ring.Material, ring.Transparency = Enum.PartType.Cylinder, Enum.Material.Neon, 1
ring.Color, ring.Size = Color3.fromRGB(70, 190, 255), Vector3.new(0.1, 1, 1)
ring.Parent = WS
cleanup[#cleanup + 1] = function() ring:Destroy() end

local lastPick, warned = 0, false
local function pickupStep()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp and fp.show then
        local d = fp.range * 2
        ring.Size = Vector3.new(0.1, d, d)
        ring.CFrame = CFrame.new(hrp.Position - Vector3.new(0, 3.2, 0)) * CFrame.Angles(0, 0, math.rad(90))
        ring.Transparency = 0.75
    else
        ring.Transparency = 1
    end
    if not fp.on or not hrp then return end
    local now = os.clock()
    if now - lastPick < 0.08 + math.random() * 0.02 then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or char:GetAttribute("cantgetball") or char:GetAttribute("InMarble") then return end
    if hasBall() or restricted(hum) then return end
    local bp = ballPos()
    if not bp or (hrp.Position - bp).Magnitude > fp.range then return end
    lastPick = now
    if not send("bytenet_findBall") and not findBallRemote() and not warned then
        warned = true
        warn("[zpost] pickup gagal: packet findBall nggak ketemu (require/remote nggak jalan di executor ini)")
    end
end

-- ===== AUTO POSITION =====
local ap = { on = false, role = "CF", team = "A" }
local ROLE_IDX = { CF = 1, LW = 2, RW = 3, CM = 4, GK = 5 }
local wiki
local function roleId(role)
    if not wiki then
        safe(function()
            local w = RS:FindFirstChild("wiki", true)
            if w then wiki = require(w) end
        end)
    end
    if wiki and type(wiki.teamroles) == "table" then
        local i = table.find(wiki.teamroles, role)
        if i then return math.clamp(i, 1, 5) end
    end
    return ROLE_IDX[role] or 1
end
local function myState()
    local chars = WS:FindFirstChild("characters")
    local c = (chars and chars:FindFirstChild(LP.Name)) or LP.Character
    return c and c:FindFirstChild("state")
end
local function myTeam()
    local t = LP.Team
    if t and t.Name ~= "" and t.Name ~= "lobby" and t.Name ~= "Spectators" then return t.Name end
    local a = LP:GetAttribute("team")
    if a and a ~= "" and a ~= "lobby" then return tostring(a) end
    local st = myState()
    local v = st and st:FindFirstChild("team")
    if v and tostring(v.Value) ~= "" and tostring(v.Value) ~= "lobby" then return tostring(v.Value) end
end
local function myRole()
    local st = myState()
    local r = st and st:FindFirstChild("role")
    return r and tostring(r.Value) or ""
end
local function roleTaken(role, team)
    local chars = WS:FindFirstChild("characters")
    if not chars then return false end
    for _, c in ipairs(chars:GetChildren()) do
        if c.Name ~= LP.Name then
            local st = c:FindFirstChild("state")
            local t = st and st:FindFirstChild("team")
            local r = st and st:FindFirstChild("role")
            if r and tostring(r.Value) == role and tostring(t and t.Value) == team then return true end
        end
    end
    return false
end
local function clickGui(role, team)
    if not firesignal then return false end
    local clicked = false
    safe(function()
        local pg = LP:FindFirstChild("PlayerGui")
        local sel = pg and pg:FindFirstChild("Select")
        local frame = sel and sel:FindFirstChild("Frame")
        local cont = frame and (frame:FindFirstChild(team) or frame:FindFirstChild("Team" .. team))
        local rf = cont and cont:FindFirstChild(role)
        if not rf then return end
        local btn = rf:FindFirstChild("Button") or rf:FindFirstChildWhichIsA("GuiButton")
            or (rf:IsA("GuiButton") and rf or nil)
        if not btn then return end
        for _, sig in ipairs({ "MouseButton1Up", "MouseButton1Click", "Activated" }) do
            pcall(function() firesignal(btn[sig]) end)
        end
        clicked = true
    end)
    return clicked
end
local function pickRole(role, team)
    if clickGui(role, team) then return end
    send("bytenet_selectRole", { index = roleId(role), t = team })
end

local lastSel = 0
local function selectStep()
    if not ap.on then return end
    local now = os.clock()
    if now - lastSel < 0.4 then return end
    local team = myTeam()
    if myRole() == ap.role and ((ap.team == "Both" and (team == "A" or team == "B")) or team == ap.team) then return end
    lastSel = now
    if ap.team == "Both" then
        if not roleTaken(ap.role, "A") then pickRole(ap.role, "A")
        elseif not roleTaken(ap.role, "B") then pickRole(ap.role, "B") end
    elseif not roleTaken(ap.role, ap.team) then
        pickRole(ap.role, ap.team)
    end
end

local hb = RunService.Heartbeat:Connect(function() safe(pickupStep) end)
cleanup[#cleanup + 1] = function() hb:Disconnect() end

local c1 = LP.CharacterAdded:Connect(function() task.wait(0.3) selectStep() end)
cleanup[#cleanup + 1] = function() c1:Disconnect() end
local pg = LP:FindFirstChild("PlayerGui")
if pg then
    local c2 = pg.ChildAdded:Connect(function(ch)
        if ch.Name == "Select" then task.wait(0.05) selectStep() end
    end)
    cleanup[#cleanup + 1] = function() c2:Disconnect() end
end
task.spawn(function()
    while alive do
        safe(selectStep)
        task.wait(0.4 + math.random() * 0.1)
    end
end)

